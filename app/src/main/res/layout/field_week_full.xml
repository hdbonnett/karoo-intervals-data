<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout: only framework views (LinearLayout, TextView, ProgressBar) are allowed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="6dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8"
            android:gravity="start" android:textSize="11sp" android:maxLines="1" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="11sp" android:textColor="@color/fitness" android:maxLines="1" android:text="Fitness" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="11sp" android:textColor="@color/fatigue" android:maxLines="1" android:text="Fatigue" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="11sp" android:textColor="@color/label" android:maxLines="1" android:text="Form" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="11sp" android:textColor="@color/cil" android:maxLines="1" android:text="CIL" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8"
            android:gravity="start" android:textSize="12sp" android:textColor="@color/label" android:maxLines="1" android:text="Now" />
        <TextView android:id="@+id/now_ctl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/fitness" android:maxLines="1" android:text="–" />
        <TextView android:id="@+id/now_atl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/fatigue" android:maxLines="1" android:text="–" />
        <TextView android:id="@+id/now_form" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:text="–" />
        <TextView android:id="@+id/now_cil" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/cil" android:maxLines="1" android:text="–" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8"
            android:gravity="start" android:textSize="12sp" android:textColor="@color/label" android:maxLines="1" android:text="Week" />
        <TextView android:id="@+id/week_ctl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/fitness" android:maxLines="1" android:text="–" />
        <TextView android:id="@+id/week_atl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/fatigue" android:maxLines="1" android:text="–" />
        <TextView android:id="@+id/week_form" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:text="–" />
        <TextView android:id="@+id/week_cil" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/cil" android:maxLines="1" android:text="–" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/label" android:text="Time" android:minWidth="40dp" />
        <TextView android:id="@+id/time_text" android:textColor="@color/field_text" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:textStyle="bold" android:maxLines="1" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:text="–" />
        <TextView android:id="@+id/time_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/bar" android:text="–" />
    </LinearLayout>
    <ProgressBar android:id="@+id/time_bar" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="2dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/week_bar" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/label" android:text="Load" android:minWidth="40dp" />
        <TextView android:id="@+id/load_text" android:textColor="@color/field_text" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:textStyle="bold" android:maxLines="1" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:text="–" />
        <TextView android:id="@+id/load_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/bar" android:text="–" />
    </LinearLayout>
    <ProgressBar android:id="@+id/load_bar" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="2dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/week_bar" />
    <TextView android:id="@+id/status_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="10sp" android:textColor="@color/label" android:maxLines="1" android:text="" />
</LinearLayout>
